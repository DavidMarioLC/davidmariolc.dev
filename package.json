    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.2.6",
    "next-cloudinary": "^6.18.8",
    "next-intl": "^4.13.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
